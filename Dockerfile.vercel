# One deployable HTTP image: React + Python API + frozen historical evidence.
# Vercel detects Dockerfile.vercel and injects PORT. It does not provide an
# always-running MQTT subscriber or persistent writable local storage.
FROM node:24-bookworm-slim AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Public build-time defaults: the Live Lab opens on the synthetic demo race.
ENV VITE_LIVE_LAB_RACE=demo-synthetic VITE_LIVE_LAB_SEASON=2026
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/engine \
    F1E_DATA_DIR=/app/data/snapshot \
    F1E_LEDGER_PATH=/app/data/evidence/ledger.jsonl \
    F1E_SBOM_PATH=/app/data/sbom/f1-sbom.cdx.json \
    F1E_SBOM_SOURCE_ROOT=/app \
    F1E_DEMO_WEB_DIR=/app/web/dist \
    F1E_BRIEF_MODE=fixture \
    F1E_LAP_TRACE_PATH=/app/data/demo-live/trace.jsonl \
    F1E_INRACE_ARTIFACT_DIR=/app/data/demo-live/artifacts \
    PORT=8080
WORKDIR /app
COPY engine/requirements.lock.txt /app/engine/requirements.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /app/engine/requirements.lock.txt
COPY engine/requirements-dev.lock.txt /app/engine/requirements-dev.lock.txt
COPY web/package-lock.json /app/web/package-lock.json
COPY engine/f1engine /app/engine/f1engine
COPY scripts /app/scripts
COPY data/snapshot /app/data/snapshot
COPY --from=frontend /src/web/dist /app/web/dist
# Build once, fail on unverified source, then ship that immutable ledger.
RUN mkdir -p /app/data/evidence /app/data/sbom \
  && python scripts/generate-sbom.py --root /app --output /app/data/sbom/f1-sbom.cdx.json \
  && python scripts/demo.py --data-dir /app/data/snapshot \
       --ledger /app/data/evidence/ledger.jsonl --season 2024 --no-serve --no-brief \
  && python -c "from f1engine.demo_site import create_unified_demo; create_unified_demo(); print('Unified site verified')"
# Synthetic Live Lab race, streamed through the real live-ingest code at build time.
RUN python scripts/build-demo-live-fixture.py --output /app/data/demo-live
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin f1demo \
  && chmod -R a+rX /app/data /app/web
USER 10001:10001
EXPOSE 8080
CMD ["python", "scripts/serve-unified-demo.py"]
