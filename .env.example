# F1 Prediction Engine — configuration surface (documentation).
# Copy to .env for local overrides. Every var carries its rationale; invalid
# values fail toward the safe default, and anything that could exfiltrate
# data defaults to loopback-only.

# F1E_DATA_DIR — snapshot location. The pinned dataset is the runtime source
# of truth; overriding it risks running against unverified data.
F1E_DATA_DIR=data/snapshot

# F1E_PORT — engine API port. The Makefile, PWA dev proxy, and docs assume 8000.
F1E_PORT=8000

# F1E_WEB_PORT — PWA dev server port (vite default).
F1E_WEB_PORT=5173

# F1E_BRIEF_MODE — fixture | live. fixture is the default so the demo runs
# offline-deterministic under a DETERMINISTIC FIXTURE banner; live requires a
# reachable Ollama and is an explicitly labeled upgrade.
F1E_BRIEF_MODE=fixture

# F1E_OLLAMA_BASE_URL — Ollama endpoint for live briefs. Loopback by default:
# race briefs never leave the machine. Only read when BRIEF_MODE=live.
F1E_OLLAMA_BASE_URL=http://127.0.0.1:11434

# F1E_OLLAMA_MODEL — model tag for live briefs. The brief task pins the digest
# via /api/tags at call time so the record states which weights answered.
F1E_OLLAMA_MODEL=

# F1E_LOG_LEVEL — engine log verbosity (debug|info|warning|error).
F1E_LOG_LEVEL=info
