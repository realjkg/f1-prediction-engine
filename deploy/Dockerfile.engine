# The prediction engine runs in a container; no local Python installation required.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/engine
WORKDIR /app
COPY engine/requirements.lock.txt /app/engine/requirements.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes -r engine/requirements.lock.txt
COPY engine/f1engine /app/engine/f1engine
COPY scripts /app/scripts
COPY engine/requirements-dev.lock.txt /app/engine/requirements-dev.lock.txt
COPY web/package-lock.json /app/web/package-lock.json
# Generate a reproducible partial CycloneDX inventory *inside* the runtime
# image. This covers pinned Python + npm dependencies, not OS/native binaries.
RUN python scripts/generate-sbom.py --root /app --output /app/data/sbom/f1-sbom.cdx.json
COPY data/snapshot /app/data/snapshot
COPY deploy/engine-entrypoint.sh /app/deploy/engine-entrypoint.sh
RUN mkdir -p /app/data/evidence /artifacts && \
    chown -R 10001:10001 /app/data/evidence /artifacts && \
    chmod +x /app/deploy/engine-entrypoint.sh
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=4s --start-period=180s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/config', timeout=3)" || exit 1
ENTRYPOINT ["/bin/sh", "/app/deploy/engine-entrypoint.sh"]
