# Private persistent MQTT collector; never deployed as a Vercel Function.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/engine
WORKDIR /app
COPY engine/requirements.lock.txt /app/engine/requirements.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /app/engine/requirements.lock.txt && \
    python -m pip install --no-cache-dir "paho-mqtt==2.1.0"
COPY engine/f1engine /app/engine/f1engine
COPY scripts /app/scripts
COPY deploy/live-collector-entrypoint.sh /app/deploy/live-collector-entrypoint.sh
RUN mkdir -p /app/data/live && chmod +x /app/deploy/live-collector-entrypoint.sh && \
    chown -R 10001:10001 /app/data/live
USER 10001:10001
ENTRYPOINT ["/bin/sh", "/app/deploy/live-collector-entrypoint.sh"]
